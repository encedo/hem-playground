# Copy to .env and fill in. Never commit .env.
# administrators (sign-in link by e-mail, or Encedo OIDC); anyone else sees only their own modules
ADMIN_EMAILS=
SESSION_SECRET=
OIDC_ISSUER=https://test.oidc.encedo.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://admin.playground.ence.do/auth/callback
# mail: sign-in links and e-mail confirmation (without it links go to the app log)
SMTP_HOST=
SMTP_MODE=starttls
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="HEM Playground<do-not-reply@encedo.com>"

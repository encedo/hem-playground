# Copy to .env and fill in. Never commit .env.
# administrators (sign-in link by e-mail, or Encedo OIDC); anyone else sees only their own modules
ADMIN_EMAILS=
SESSION_SECRET=
OIDC_ISSUER=https://test.oidc.encedo.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://admin.playground.ence.do/auth/callback
# mail: sign-in links and e-mail confirmation (without it links go to the app log)
SMTP_HOST=
SMTP_MODE=starttls
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="HEM Playground<do-not-reply@encedo.com>"
# the attestation key every module signs with, and its certificate from the Encedo EPA Custody CA
# for *.<domain> (node server/tools/make-att-csr.mjs <domain>: the key line goes here, the CSR to the CA);
# without them each module signs with its own key and has no certificate
PG_ATT_KEY=
PG_ATT_CERT=
# module data encrypted at rest in Redis: 32 random bytes in base64 (openssl rand -base64 32);
# keep a copy outside this directory. PG_DATA_KEY_OLD only while a rotation runs (README, Deploy).
# Without PG_DATA_KEY module data is stored in plain text; once Redis holds encrypted data the app
# does not start without it
PG_DATA_KEY=
PG_DATA_KEY_OLD=

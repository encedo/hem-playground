{
	local_certs
	on_demand_tls {
		ask http://app:8080/healthz/tls
	}
}

# Every HTTPS request, also one without a Host header (HTTP/1.0, hem-api-tester T-15.18):
# the module is chosen by the TLS server name, and the client's own Host goes along
# in X-Orig-Host (empty when it sent none), as nginx does on the server.
:443 {
	tls internal {
		on_demand
	}
	# The module says "Connection: keep-alive" when it keeps the connection (hem-api-tester T-1.6);
	# Caddy drops that hop-by-hop header from the upstream reply, so it is set again here.
	@keepalive header Connection *keep-alive*
	header @keepalive >Connection keep-alive
	reverse_proxy app:8080 {
		header_up Host {http.request.tls.server_name}
		header_up X-Orig-Host "{http.request.host}"
		header_up X-Forwarded-Proto https
		header_up X-Orig-Content-Length "{http.request.header.Content-Length}"
	}
}

:80 {
	reverse_proxy app:8080 {
		header_up X-Forwarded-Proto http
		header_up X-Orig-Content-Length "{http.request.header.Content-Length}"
	}
}
